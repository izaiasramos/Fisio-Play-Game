  "itens": [
    { "id": "neu-001", "trilhaId": "neuro", "termo": "AVC (Acidente Vascular Cerebral)", "definicao": "Déficit neurológico súbito por interrupção do fluxo sanguíneo cerebral (isquêmico) ou por sangramento (hemorrágico); principal causa de incapacidade em adultos.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/MCA_Territory_Infarct.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:MCA_Territory_Infarct.svg", "imagemCredito": "INFARCT.jpg : Lucien Monfils derivative work: Suraj · CC BY-SA 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430927/" },
    { "id": "neu-002", "trilhaId": "neuro", "termo": "Hemiplegia", "definicao": "Paralisia completa de um lado do corpo, geralmente contralateral a uma lesão do neurônio motor superior (ex.: após AVC).", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Hemiparesis_by_hariadhi_dedicated_to_my_dad.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Hemiparesis_by_hariadhi_dedicated_to_my_dad.svg", "imagemCredito": "Hariadhi · CC BY-SA 4.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537305/" },
    { "id": "neu-003", "trilhaId": "neuro", "termo": "Hemiparesia", "definicao": "Fraqueza (paralisia parcial) de um lado do corpo, com força muscular reduzida mas movimento ainda presente.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537305/" },
    { "id": "neu-004", "trilhaId": "neuro", "termo": "Escala de Coma de Glasgow", "definicao": "Avalia o nível de consciência somando abertura ocular, resposta verbal e resposta motora, de 3 (coma profundo) a 15 (normal).", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK513298/" },
    { "id": "neu-005", "trilhaId": "neuro", "termo": "Escala de Ashworth Modificada", "definicao": "Gradua a espasticidade de 0 a 4 pela resistência sentida à mobilização passiva do membro.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK554572/" },
    { "id": "neu-006", "trilhaId": "neuro", "termo": "Espasticidade", "definicao": "Aumento do tônus muscular dependente da velocidade, sinal de lesão do neurônio motor superior, com resistência ao alongamento rápido.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK507869/" },
    { "id": "neu-007", "trilhaId": "neuro", "termo": "Tônus muscular", "definicao": "Tensão de repouso do músculo; pode estar aumentado (hipertonia/espasticidade) ou reduzido (hipotonia) conforme a lesão.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK507869/" },
    { "id": "neu-008", "trilhaId": "neuro", "termo": "Reflexo tendíneo profundo", "definicao": "Contração muscular involuntária ao percutir um tendão, que testa o arco reflexo medular e as vias motoras descendentes.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Patellar_tendon_reflex_arc.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Patellar_tendon_reflex_arc.png", "imagemCredito": "Amiya Sarkar · CC BY-SA 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK562238/" },
    { "id": "neu-009", "trilhaId": "neuro", "termo": "Reflexo patelar", "definicao": "Extensão do joelho ao percutir o tendão patelar; reflexo profundo que avalia principalmente as raízes L2-L4.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Patellar-knee-reflex.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Patellar-knee-reflex.png", "imagemCredito": "ChristinaT3 ( talk ) · CC BY-SA 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK562238/" },
    { "id": "neu-010", "trilhaId": "neuro", "termo": "Sinal de Babinski", "definicao": "Extensão do hálux e abertura em leque dos dedos ao estimular a planta do pé; quando presente no adulto, indica lesão do trato corticoespinhal.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Lawrence_1960_20.4-en.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Lawrence_1960_20.4-en.svg", "imagemCredito": "Jmarchn · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK519009/" },
    { "id": "neu-011", "trilhaId": "neuro", "termo": "Escala de força MRC", "definicao": "Gradua a força de 0 a 5: o grau 0 corresponde à plegia (nenhuma contração) e os graus 1 a 4 à paresia, permitindo acompanhar a evolução da fraqueza em lesões neurológicas.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK436008/" },
    { "id": "neu-012", "trilhaId": "neuro", "termo": "Neurônio motor superior", "definicao": "Neurônio que vai do córtex/tronco à medula; sua lesão causa hipertonia, hiperreflexia, espasticidade e Babinski positivo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray764.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray764.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537305/" },
    { "id": "neu-013", "trilhaId": "neuro", "termo": "Neurônio motor inferior", "definicao": "Neurônio que vai da medula ao músculo; sua lesão causa hipotonia, hiporreflexia, atrofia e fasciculações.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray764.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray764.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK539814/" },
    { "id": "neu-014", "trilhaId": "neuro", "termo": "Doença de Parkinson", "definicao": "Doença neurodegenerativa por perda de dopamina, marcada por tremor de repouso, rigidez, bradicinesia e instabilidade postural.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Parkinson%E2%80%99s_disease_1880s.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Parkinson’s_disease_1880s.jpg", "imagemCredito": "William Gowers; retouched by User:Dustfreeworld · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470193/" },
    { "id": "neu-015", "trilhaId": "neuro", "termo": "Bradicinesia", "definicao": "Lentidão e redução da amplitude dos movimentos voluntários; sinal cardinal da doença de Parkinson.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470193/" },
    { "id": "neu-016", "trilhaId": "neuro", "termo": "Rigidez em roda denteada", "definicao": "Resistência uniforme com interrupções sucessivas à mobilização passiva, típica da doença de Parkinson.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470193/" },
    { "id": "neu-017", "trilhaId": "neuro", "termo": "Tremor de repouso", "definicao": "Tremor que aparece com o membro relaxado e diminui ao iniciar o movimento; característico do parkinsonismo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Parkinson%E2%80%99s_disease_1880s.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Parkinson’s_disease_1880s.jpg", "imagemCredito": "William Gowers (retoque: User:Dustfreeworld) · Domínio público", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470193/" },
    { "id": "neu-018", "trilhaId": "neuro", "termo": "Esclerose múltipla", "definicao": "Doença autoimune desmielinizante do sistema nervoso central, com surtos e sintomas variados como fadiga, ataxia e alterações sensitivas.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/MS_Demyelinisation_CD68_10xv2.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:MS_Demyelinisation_CD68_10xv2.jpg", "imagemCredito": "Marvin 101 · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK499849/" },
    { "id": "neu-019", "trilhaId": "neuro", "termo": "Lesão medular", "definicao": "Dano à medula espinhal que compromete funções motoras, sensitivas e autonômicas abaixo do nível da lesão.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Cervical_Spine_MRI_%28T2W%29.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Cervical_Spine_MRI_(T2W).jpg", "imagemCredito": "Андрей Королев 86 · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560721/" },
    { "id": "neu-020", "trilhaId": "neuro", "termo": "Paraplegia", "definicao": "Paralisia dos membros inferiores por lesão medular torácica ou lombar, preservando os membros superiores.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Neurological_Levels_%26_Types_of_Paralysis.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Neurological_Levels_&_Types_of_Paralysis.png", "imagemCredito": "Servier Medical Art · CC BY 2.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560721/" },
    { "id": "neu-021", "trilhaId": "neuro", "termo": "Tetraplegia", "definicao": "Comprometimento dos quatro membros por lesão medular cervical, podendo afetar também a musculatura respiratória.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Neurological_Levels_%26_Types_of_Paralysis.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Neurological_Levels_&_Types_of_Paralysis.png", "imagemCredito": "Servier Medical Art · CC BY 2.0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560721/" },
    { "id": "neu-022", "trilhaId": "neuro", "termo": "Paralisia cerebral", "definicao": "Grupo de desordens permanentes do movimento e da postura por lesão do encéfalo em desenvolvimento (pré, peri ou pós-natal).", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK538147/" },
    { "id": "neu-023", "trilhaId": "neuro", "termo": "Traumatismo cranioencefálico", "definicao": "Lesão cerebral por trauma externo, classificada em leve, moderada ou grave conforme a Escala de Coma de Glasgow.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Brain_trauma_CT.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Brain_trauma_CT.jpg", "imagemCredito": "Rehman T, Ali R, Tawil I, Yonas H · CC BY 2.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK557861/" },
    { "id": "neu-024", "trilhaId": "neuro", "termo": "Coma", "definicao": "Estado de ausência de resposta e de despertar, refletindo falência da função encefálica por causa estrutural ou metabólica.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Comaventilator.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Comaventilator.jpg", "imagemCredito": "Aaron Cohen · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430722/" },
    { "id": "neu-025", "trilhaId": "neuro", "termo": "Ataxia", "definicao": "Incoordenação dos movimentos, geralmente por disfunção cerebelar, que afeta marcha, equilíbrio e precisão dos gestos.", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/16-1-overview-of-the-neurological-exam" },
    { "id": "neu-026", "trilhaId": "neuro", "termo": "Marcha ceifante", "definicao": "Marcha hemiplégica em que o membro inferior espástico faz um movimento de circundução para avançar, arrastando o pé.", "dificuldade": 3, "fonte": "Stroke Rehabilitation (NICE Clinical Guideline) — NCBI Bookshelf", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK327894/" },
    { "id": "neu-027", "trilhaId": "neuro", "termo": "Propriocepção", "definicao": "Sentido da posição e do movimento do corpo no espaço, essencial para o controle motor e o equilíbrio.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Proprioception_image-01.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Proprioception_image-01.jpg", "imagemCredito": "John Tuthill · CC BY-SA 4.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/14-1-sensory-perception" },
    { "id": "neu-028", "trilhaId": "neuro", "termo": "Conceito Bobath", "definicao": "Abordagem neuroevolutiva que trata alterações de tônus e padrões de movimento facilitando o controle postural e o movimento normal.", "dificuldade": 3, "fonte": "Stroke Rehabilitation (NICE Clinical Guideline) — NCBI Bookshelf", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK327894/" },
    { "id": "neu-029", "trilhaId": "neuro", "termo": "Afasia", "definicao": "Perda ou alteração da linguagem por lesão de áreas cerebrais (ex.: Broca ou Wernicke), afetando a fala e/ou a compreensão.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Aphasia.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Aphasia.png", "imagemCredito": "Bertyhell · CC BY-SA 3.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/14-2-central-processing" },
    { "id": "neu-030", "trilhaId": "neuro", "termo": "Sistema nervoso central", "definicao": "Formado pelo encéfalo e pela medula espinhal; integra as informações e comanda as respostas motoras do corpo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/1201_Overview_of_Nervous_System.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:1201_Overview_of_Nervous_System.jpg", "imagemCredito": "OpenStax · CC BY 4.0", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/13-2-the-central-nervous-system" },
    { "id": "neu-031", "trilhaId": "neuro", "termo": "Escala de Berg", "definicao": "Avalia o equilíbrio por 14 tarefas funcionais (0-56 pontos); pontuações baixas indicam maior risco de queda.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK574518/" },
    { "id": "neu-032", "trilhaId": "neuro", "termo": "Índice de Barthel", "definicao": "Mede a independência nas atividades básicas de vida diária (banho, vestir, marcha), útil no acompanhamento pós-AVC.", "dificuldade": 2, "fonte": "Stroke Rehabilitation (NICE Clinical Guideline) — NCBI Bookshelf", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK327894/" },
    { "id": "neu-033", "trilhaId": "neuro", "termo": "Medida de Independência Funcional (MIF)", "definicao": "Instrumento que quantifica o grau de auxílio necessário nas atividades motoras e cognitivas do paciente.", "dificuldade": 2, "fonte": "Stroke Rehabilitation (NICE Clinical Guideline) — NCBI Bookshelf", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK327894/" },
    { "id": "neu-034", "trilhaId": "neuro", "termo": "Marcha atáxica", "definicao": "Marcha instável, com base alargada e passos irregulares, típica de disfunção cerebelar.", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/16-1-overview-of-the-neurological-exam" },
    { "id": "neu-035", "trilhaId": "neuro", "termo": "Marcha parkinsoniana", "definicao": "Marcha com passos curtos e arrastados, postura fletida e redução do balanço dos braços, típica do Parkinson.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470193/" },
    { "id": "neu-036", "trilhaId": "neuro", "termo": "Festinação", "definicao": "Aceleração involuntária dos passos com tendência a cair para frente, observada na doença de Parkinson.", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470193/" },
    { "id": "neu-037", "trilhaId": "neuro", "termo": "Nistagmo", "definicao": "Movimento ocular rítmico e involuntário, sinal de disfunção vestibular ou cerebelar.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Optokinetic_nystagmus.gif?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Optokinetic_nystagmus.gif", "imagemCredito": "Student BSMU at English Wikipedia · CC BY-SA 3.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/16-1-overview-of-the-neurological-exam" },
    { "id": "neu-038", "trilhaId": "neuro", "termo": "Disartria", "definicao": "Distúrbio motor da fala por fraqueza ou incoordenação da musculatura da articulação, comum após AVC.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK592453/" },
    { "id": "neu-039", "trilhaId": "neuro", "termo": "Apraxia", "definicao": "Incapacidade de executar movimentos aprendidos apesar de força e compreensão preservadas, por lesão cortical.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Apraxia_001.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Apraxia_001.jpg", "imagemCredito": "No machine-readable author provided. Mediciman90 assumed (based on copyright claims). · Public domain", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK585110/" },
    { "id": "neu-040", "trilhaId": "neuro", "termo": "Negligência hemiespacial", "definicao": "Desatenção a um lado do espaço/corpo (geralmente o esquerdo) após lesão do hemisfério direito.", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK562184/" },
    { "id": "neu-041", "trilhaId": "neuro", "termo": "Síndrome de Guillain-Barré", "definicao": "Polirradiculoneuropatia autoimune aguda com fraqueza ascendente e arreflexia, muitas vezes pós-infecção.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK532254/" },
