  "itens": [
    { "id": "ort-001", "trilhaId": "ortopedia", "termo": "Teste de Lachman", "definicao": "Teste mais sensível para lesão do LCA: com o joelho a ~30° de flexão, traciona-se a tíbia para frente e avalia-se a translação e a qualidade do ponto final.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/ACLI_17.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:ACLI_17.jpg", "imagemCredito": "Mak-Ham Lam, Daniel TP Fong, Patrick SH Yung, Eric PY Ho, Wood-Yee Chan and Kai-Ming Chan · CC BY-SA 2.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK554415/" },
    { "id": "ort-002", "trilhaId": "ortopedia", "termo": "Teste da gaveta anterior do joelho", "definicao": "Com o joelho a 90° de flexão, traciona-se a tíbia anteriormente; deslocamento aumentado sugere lesão do ligamento cruzado anterior.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK554415/" },
    { "id": "ort-003", "trilhaId": "ortopedia", "termo": "Lesão do LCA", "definicao": "Ruptura do ligamento cruzado anterior, comum em esportes com giro e desaceleração; causa instabilidade do joelho e é o ligamento cruzado mais lesado.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Knee_diagram.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Knee_diagram.svg", "imagemCredito": "Mysid · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK499848/" },
    { "id": "ort-004", "trilhaId": "ortopedia", "termo": "Teste de McMurray", "definicao": "Manobra de rotação e extensão do joelho que provoca dor ou estalido quando há lesão de menisco.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK431067/" },
    { "id": "ort-005", "trilhaId": "ortopedia", "termo": "Lesão de menisco", "definicao": "Ruptura da fibrocartilagem entre fêmur e tíbia, que causa dor, bloqueio articular e derrame; comum em torções do joelho.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray349.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray349.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK431067/" },
    { "id": "ort-006", "trilhaId": "ortopedia", "termo": "Teste de Neer", "definicao": "Elevação passiva do braço em rotação medial que reproduz dor no impacto subacromial do ombro.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK551702/" },
    { "id": "ort-007", "trilhaId": "ortopedia", "termo": "Teste de Hawkins-Kennedy", "definicao": "Com ombro e cotovelo a 90°, faz-se rotação medial do ombro; dor indica impacto do supraespinhal contra o arco coracoacromial.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK551702/" },
    { "id": "ort-008", "trilhaId": "ortopedia", "termo": "Síndrome do impacto do ombro", "definicao": "Compressão dolorosa dos tendões do manguito rotador sob o arco coracoacromial durante a elevação do braço.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Shoulder_joint.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Shoulder_joint.svg", "imagemCredito": "National Institute Of Arthritis And Musculoskeletal And Skin Diseases (NIAMS); SVG version by Angelito7 · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK551702/" },
    { "id": "ort-009", "trilhaId": "ortopedia", "termo": "Tendinopatia do supraespinhal", "definicao": "Degeneração/inflamação do tendão do supraespinhal, principal causa de dor no manguito rotador e limitação da abdução do ombro.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Supraspinatus_muscle_back4.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Supraspinatus_muscle_back4.png", "imagemCredito": "Anatomography · CC BY-SA 2.1 jp", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK551702/" },
    { "id": "ort-010", "trilhaId": "ortopedia", "termo": "Capsulite adesiva", "definicao": "Ombro congelado: rigidez progressiva e perda de mobilidade ativa e passiva por espessamento e retração da cápsula articular.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray327.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray327.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK532955/" },
    { "id": "ort-011", "trilhaId": "ortopedia", "termo": "Sinal de Finkelstein", "definicao": "Desvio ulnar do punho com o polegar fletido dentro da mão; dor sobre o estiloide radial indica tenossinovite de De Quervain.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Originaler_Finkelstein-Test.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Originaler_Finkelstein-Test.jpg", "imagemCredito": "PhilippN · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK539768/" },
    { "id": "ort-012", "trilhaId": "ortopedia", "termo": "Tenossinovite de De Quervain", "definicao": "Inflamação dos tendões abdutor longo e extensor curto do polegar no primeiro compartimento extensor do punho.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Finkelstein_Test_Arrow.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Finkelstein_Test_Arrow.jpg", "imagemCredito": "James Heilman, MD · CC BY-SA 4.0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK539768/" },
    { "id": "ort-013", "trilhaId": "ortopedia", "termo": "Teste de Phalen", "definicao": "Flexão máxima dos punhos por ~60s; formigamento no território do nervo mediano sugere síndrome do túnel do carpo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Phalen%27s_Maneuver.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Phalen's_Maneuver.jpg", "imagemCredito": "LittleT889 · CC BY-SA 4.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK448179/" },
    { "id": "ort-014", "trilhaId": "ortopedia", "termo": "Sinal de Tinel", "definicao": "Percussão sobre um nervo (ex.: mediano no punho) que provoca formigamento distal, indicando irritação ou compressão nervosa.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Carpal-Tunnel.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Carpal-Tunnel.svg", "imagemCredito": "DoPhotoShop · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK448179/" },
    { "id": "ort-015", "trilhaId": "ortopedia", "termo": "Síndrome do túnel do carpo", "definicao": "Compressão do nervo mediano no túnel do carpo, causando dormência e fraqueza na mão, sobretudo à noite.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Untreated_Carpal_Tunnel_Syndrome.JPG?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Untreated_Carpal_Tunnel_Syndrome.JPG", "imagemCredito": "Dr. Harry Gouvas, MD, PhD · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK448179/" },
    { "id": "ort-016", "trilhaId": "ortopedia", "termo": "Epicondilite lateral", "definicao": "Cotovelo de tenista: dor no epicôndilo lateral por sobrecarga dos tendões extensores do punho, especialmente do extensor radial curto do carpo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/En-elbow_joint.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:En-elbow_joint.svg", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK431092/" },
    { "id": "ort-017", "trilhaId": "ortopedia", "termo": "Entorse de tornozelo", "definicao": "Estiramento ou ruptura dos ligamentos do tornozelo, mais comum no complexo lateral após inversão do pé.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Ankle_en.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Ankle_en.svg", "imagemCredito": "An svg version of image:Ankle.PNG by me ( Jak ). · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK459212/" },
    { "id": "ort-018", "trilhaId": "ortopedia", "termo": "Teste da gaveta anterior do tornozelo", "definicao": "Tração anterior do calcâneo com a tíbia fixa; deslocamento aumentado indica lesão do ligamento talofibular anterior.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK459212/" },
    { "id": "ort-019", "trilhaId": "ortopedia", "termo": "Protocolo POLICE", "definicao": "Conduta inicial de lesão aguda de partes moles: Proteção, Carga Ótima (Optimal Loading), Gelo (Ice), Compressão e Elevação — evolução do antigo RICE.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK459212/" },
    { "id": "ort-020", "trilhaId": "ortopedia", "termo": "Hérnia de disco", "definicao": "Deslocamento do núcleo pulposo através do ânulo fibroso, que pode comprimir raízes nervosas e causar dor irradiada.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Hernie_discale_L4_L5.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Hernie_discale_L4_L5.png", "imagemCredito": "Miguel Tremblay · CC0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK441822/" },
    { "id": "ort-021", "trilhaId": "ortopedia", "termo": "Ciática", "definicao": "Dor radicular que irradia pelo trajeto do nervo isquiático, geralmente por compressão de raiz lombar (ex.: hérnia de disco L4-S1).", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Sciatic_nerve2.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Sciatic_nerve2.jpg", "imagemCredito": "KDS4444 · CC BY-SA 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK441822/" },
    { "id": "ort-022", "trilhaId": "ortopedia", "termo": "Teste de Lasègue", "definicao": "Elevação passiva da perna estendida em decúbito dorsal; dor irradiada abaixo do joelho sugere compressão de raiz nervosa lombar.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Straight-leg-test.gif?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Straight-leg-test.gif", "imagemCredito": "Davidjr74 · CC0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK441822/" },
    { "id": "ort-023", "trilhaId": "ortopedia", "termo": "Marcha de Trendelenburg", "definicao": "Queda da pelve do lado oposto durante o apoio unipodal, por fraqueza dos abdutores do quadril (glúteos médio e mínimo).", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK541094/" },
    { "id": "ort-024", "trilhaId": "ortopedia", "termo": "Sinal de Trendelenburg", "definicao": "Ao apoiar em uma perna, a pelve contralateral cai em vez de subir, indicando insuficiência dos abdutores do quadril do lado de apoio.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK541094/" },
    { "id": "ort-025", "trilhaId": "ortopedia", "termo": "Síndrome compartimental aguda", "definicao": "Aumento da pressão dentro de um compartimento fascial fechado que compromete a circulação; emergência que exige fasciotomia.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Fasciotomyforearm.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Fasciotomyforearm.jpg", "imagemCredito": "TPompert · CC BY-SA 4.0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK448124/" },
    { "id": "ort-026", "trilhaId": "ortopedia", "termo": "Amplitude de movimento (ADM)", "definicao": "Grau de deslocamento possível em uma articulação, medido em graus (ex.: com goniômetro); pode ser ativa ou passiva.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Braus_1921_290.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Braus_1921_290.png", "imagemCredito": "Braus, Hermann · Public domain", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-5-types-of-body-movements" },
    { "id": "ort-027", "trilhaId": "ortopedia", "termo": "Flexão e extensão", "definicao": "Flexão diminui e extensão aumenta o ângulo entre dois ossos no plano sagital de uma articulação.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Braus_1921_290.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Braus_1921_290.png", "imagemCredito": "Braus, Hermann · Public domain", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-5-types-of-body-movements" },
    { "id": "ort-028", "trilhaId": "ortopedia", "termo": "Abdução e adução", "definicao": "Abdução afasta e adução aproxima um segmento da linha média do corpo, no plano frontal.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Braus_1921_290.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Braus_1921_290.png", "imagemCredito": "Braus, Hermann · Public domain", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-5-types-of-body-movements" },
    { "id": "ort-029", "trilhaId": "ortopedia", "termo": "Articulação sinovial", "definicao": "Articulação móvel cujas superfícies são separadas por cavidade com líquido sinovial; base da maioria das articulações avaliadas em ortopedia.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/907_Synovial_Joints.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:907_Synovial_Joints.jpg", "imagemCredito": "OpenStax College · CC BY 3.0", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-4-synovial-joints" },
    { "id": "ort-030", "trilhaId": "ortopedia", "termo": "Escala de força muscular (MRC)", "definicao": "Gradua a força de 0 (sem contração) a 5 (força normal contra resistência máxima), usada no teste manual de força.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK436008/" },
    { "id": "ort-031", "trilhaId": "ortopedia", "termo": "Teste de Ober", "definicao": "Avalia o encurtamento do trato iliotibial: em decúbito lateral, o quadril não consegue aduzir com a coxa em extensão.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK542185/" },
    { "id": "ort-032", "trilhaId": "ortopedia", "termo": "Teste de Apley", "definicao": "Com o paciente em prono e joelho a 90°, compressão + rotação da tíbia que provoca dor indica lesão de menisco.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470549/" },
    { "id": "ort-033", "trilhaId": "ortopedia", "termo": "Teste de Thompson", "definicao": "Com o paciente em prono, aperta-se a panturrilha; a ausência de flexão plantar sugere ruptura do tendão de Aquiles.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Rupture_tendon_achil%C3%A9en.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Rupture_tendon_achiléen.jpg", "imagemCredito": "Grook Da Oger · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430844/" },
    { "id": "ort-034", "trilhaId": "ortopedia", "termo": "Ruptura do tendão de Aquiles", "definicao": "Ruptura do tendão do calcâneo, comum em atividades de impulso; cursa com dor súbita e perda da flexão plantar.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/1123_Muscles_of_the_Leg_that_Move_the_Foot_and_Toes_b.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:1123_Muscles_of_the_Leg_that_Move_the_Foot_and_Toes_b.png", "imagemCredito": "J. Gordon Betts, Kelly A. Young, James A. Wise, Eddie Johnson, Brandon Poe, Dean H. Kruse, Oksana Korol, Jody  · CC BY 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430844/" },
    { "id": "ort-035", "trilhaId": "ortopedia", "termo": "Teste da gaveta posterior", "definicao": "Com o joelho a 90°, empurra-se a tíbia para trás; deslocamento aumentado indica lesão do ligamento cruzado posterior.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430726/" },
    { "id": "ort-036", "trilhaId": "ortopedia", "termo": "Lesão do LCP", "definicao": "Lesão do ligamento cruzado posterior, menos comum que a do LCA, geralmente por trauma direto na tíbia com joelho fletido.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Knee_diagram.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Knee_diagram.svg", "imagemCredito": "Mysid · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430726/" },
