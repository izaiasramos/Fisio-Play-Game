  "itens": [
    { "id": "ger-001", "trilhaId": "saude-geral", "termo": "Sinais vitais", "definicao": "Parâmetros básicos do estado clínico: frequência cardíaca, frequência respiratória, pressão arterial, temperatura e saturação de oxigênio.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553213/" },
    { "id": "ger-002", "trilhaId": "saude-geral", "termo": "Frequência cardíaca", "definicao": "Aferida contando o pulso radial por um minuto e observando também ritmo e amplitude; no adulto em repouso costuma variar entre 60 e 100 bpm.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Normal_electrocardiogram.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Normal_electrocardiogram.jpg", "imagemCredito": "medipics1066 · CC BY 2.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553213/" },
    { "id": "ger-003", "trilhaId": "saude-geral", "termo": "Frequência respiratória", "definicao": "Número de incursões respiratórias por minuto; no adulto em repouso situa-se em torno de 12 a 20 irpm.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553213/" },
    { "id": "ger-004", "trilhaId": "saude-geral", "termo": "Pressão arterial", "definicao": "Aferida com manguito de tamanho adequado, no braço apoiado à altura do coração e com o paciente em repouso; manguito estreito ou braço pendente falseiam o valor.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Blood_pressure_monitoring.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Blood_pressure_monitoring.jpg", "imagemCredito": "rawpixel.com · CC0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482189/" },
    { "id": "ger-005", "trilhaId": "saude-geral", "termo": "Temperatura corporal", "definicao": "Grau de calor do corpo, normalmente ~36 a 37,5 °C; febre e hipotermia são desvios importantes na avaliação.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553213/" },
    { "id": "ger-006", "trilhaId": "saude-geral", "termo": "Saturação de oxigênio (SpO2)", "definicao": "Percentual de hemoglobina ligada ao oxigênio, medido por oxímetro; normalmente entre 95 e 100%.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Wrist-oximeter.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Wrist-oximeter.jpg", "imagemCredito": "UusiAjaja · CC0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470348/" },
    { "id": "ger-007", "trilhaId": "saude-geral", "termo": "Avaliação da dor", "definicao": "Caracterização sistemática da dor: localização, intensidade, duração e fatores que agravam ou aliviam.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK556098/" },
    { "id": "ger-008", "trilhaId": "saude-geral", "termo": "Escala Visual Analógica (EVA)", "definicao": "Instrumento de autorrelato da dor: na EVA clássica o paciente marca um ponto em uma linha de 10 cm sem números; na versão numérica (Escala Numérica de Dor, 0 a 10) ele indica um valor. Ambas são simples e muito usadas.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK556098/" },
    { "id": "ger-009", "trilhaId": "saude-geral", "termo": "Teste muscular manual", "definicao": "Avaliação em que o examinador posiciona o segmento, estabiliza a articulação proximal e aplica resistência para graduar a força de um músculo ou grupo muscular.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK436008/" },
    { "id": "ger-010", "trilhaId": "saude-geral", "termo": "Amplitude de movimento (ADM)", "definicao": "Arco articular que o próprio paciente executa (ativa) ou que o avaliador conduz sem esforço dele (passiva); registrar qual das duas foi avaliada é essencial.", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-5-types-of-body-movements" },
    { "id": "ger-011", "trilhaId": "saude-geral", "termo": "Goniometria", "definicao": "Medida do ângulo articular com goniômetro para quantificar e acompanhar a amplitude de movimento.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Goniometer_IMG_4841.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Goniometer_IMG_4841.jpg", "imagemCredito": "Rama · CC BY-SA 2.0 fr", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/9-5-types-of-body-movements" },
    { "id": "ger-012", "trilhaId": "saude-geral", "termo": "Homeostase", "definicao": "Manutenção de um ambiente interno estável (temperatura, pH, glicemia) apesar das variações externas.", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/1-5-homeostasis" },
    { "id": "ger-013", "trilhaId": "saude-geral", "termo": "Posição anatômica", "definicao": "Posição-zero de referência da avaliação: os termos direcionais e as medidas angulares partem dela, e direita e esquerda são sempre as do paciente, não as do observador.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/View_of_Viscera_Page_82.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:View_of_Viscera_Page_82.jpg", "imagemCredito": "Sue Clark · Public domain", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/1-6-anatomical-terminology" },
    { "id": "ger-014", "trilhaId": "saude-geral", "termo": "Planos anatômicos", "definicao": "Conjunto de três planos de referência mutuamente perpendiculares — sagital, frontal (coronal) e transverso — usados para descrever o corpo e localizar seus movimentos.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Human_anatomy_planes%2C_labeled.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Human_anatomy_planes,_labeled.svg", "imagemCredito": "David Richfield and Mikael Häggström, M.D. and cmglee · CC BY-SA 4.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/1-6-anatomical-terminology" },
    { "id": "ger-015", "trilhaId": "saude-geral", "termo": "Anamnese", "definicao": "Entrevista clínica que levanta queixa, história da doença atual, antecedentes e hábitos para orientar a avaliação.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553213/" },
    { "id": "ger-016", "trilhaId": "saude-geral", "termo": "Úlcera por pressão", "definicao": "Lesão da pele e tecidos sobre proeminências ósseas por pressão prolongada, comum em pacientes acamados.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Decubitus_ulcer_stage_4.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Decubitus_ulcer_stage_4.jpg", "imagemCredito": "Noles1984 ( talk ) 15:45, 7 May 2008 (UTC) · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553107/" },
    { "id": "ger-017", "trilhaId": "saude-geral", "termo": "Estágios da úlcera por pressão", "definicao": "Classificação em estágios 1 a 4 (mais lesão em não classificáveis) conforme a profundidade do dano tecidual.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Decubitus_ulcer_stage_4.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Decubitus_ulcer_stage_4.jpg", "imagemCredito": "Noles1984 ( talk ) 15:45, 7 May 2008 (UTC) · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553107/" },
    { "id": "ger-018", "trilhaId": "saude-geral", "termo": "Mudança de decúbito", "definicao": "Reposicionamento periódico do paciente acamado para aliviar a pressão e prevenir úlceras por pressão.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553107/" },
    { "id": "ger-019", "trilhaId": "saude-geral", "termo": "Prevenção de quedas", "definicao": "Conjunto de medidas (exercício de equilíbrio/força, revisão do ambiente e de medicamentos) para reduzir quedas, sobretudo em idosos.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Walker._frame.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Walker._frame.jpg", "imagemCredito": "High Plains Drifter (English Wikipedia) · Domínio público", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560761/" },
    { "id": "ger-020", "trilhaId": "saude-geral", "termo": "Avaliação de risco de quedas", "definicao": "Triagem de fatores de risco (histórico de quedas, equilíbrio, marcha, medicamentos) para direcionar a prevenção.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560761/" },
    { "id": "ger-021", "trilhaId": "saude-geral", "termo": "Equilíbrio", "definicao": "Capacidade de manter o centro de massa sobre a base de apoio; treiná-lo reduz o risco de quedas.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Model_Balancing.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Model_Balancing.jpg", "imagemCredito": "Ye Rose Studio, Providence, R.I. · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560761/" },
    { "id": "ger-022", "trilhaId": "saude-geral", "termo": "Fragilidade", "definicao": "Síndrome de vulnerabilidade do idoso, com perda de reserva funcional, que eleva o risco de quedas e hospitalização.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK543821/" },
    { "id": "ger-023", "trilhaId": "saude-geral", "termo": "Sarcopenia", "definicao": "Perda progressiva de massa e força muscular com o envelhecimento, tratada principalmente com exercício resistido.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/1025_Atrophy.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:1025_Atrophy.png", "imagemCredito": "OpenStax · CC BY 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK543821/" },
    { "id": "ger-024", "trilhaId": "saude-geral", "termo": "Atividade física", "definicao": "Qualquer movimento corporal que gasta energia; sua prática regular previne doenças crônicas e melhora a função.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK572051/" },
    { "id": "ger-025", "trilhaId": "saude-geral", "termo": "Exercício aeróbico", "definicao": "Atividade contínua e rítmica (caminhada, bicicleta) que melhora o condicionamento cardiorrespiratório.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Bicycles_at_Frederiksberg_-_Flickr_-_Kristoffer_Trolle.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Bicycles_at_Frederiksberg_-_Flickr_-_Kristoffer_Trolle.jpg", "imagemCredito": "Kristoffer Trolle from Copenhagen, Denmark · CC BY 2.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK572051/" },
    { "id": "ger-026", "trilhaId": "saude-geral", "termo": "Sedentarismo", "definicao": "Baixo nível de atividade física, fator de risco para obesidade, doenças cardiovasculares e perda funcional.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Family_watching_television_1958.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Family_watching_television_1958.jpg", "imagemCredito": "Evert F. Baumgardner · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK572051/" },
    { "id": "ger-027", "trilhaId": "saude-geral", "termo": "Mobilização precoce", "definicao": "Retomada de movimento e atividade o quanto antes após lesão, cirurgia ou internação, para evitar complicações da imobilidade.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK572051/" },
    { "id": "ger-028", "trilhaId": "saude-geral", "termo": "Edema", "definicao": "Acúmulo de líquido no interstício que causa inchaço; pode ter origem venosa, linfática, cardíaca ou inflamatória.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Combinpedal.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Combinpedal.jpg", "imagemCredito": "James Heilman, MD · CC BY-SA 3.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/20-2-blood-flow-blood-pressure-and-resistance" },
    { "id": "ger-029", "trilhaId": "saude-geral", "termo": "Respiração diafragmática", "definicao": "Padrão respiratório que enfatiza o uso do diafragma para melhorar a ventilação e reduzir o trabalho respiratório.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Diaphragmatic_breathing.gif?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Diaphragmatic_breathing.gif", "imagemCredito": "John Pierce · CC0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/22-3-the-process-of-breathing" },
