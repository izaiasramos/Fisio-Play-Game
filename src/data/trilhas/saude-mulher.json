    { "id": "mul-036", "trilhaId": "saude-mulher", "termo": "Kegel na gestação", "definicao": "Fortalecimento do assoalho pélvico durante a gravidez para prevenir incontinência e preparar para o parto.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray405.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray405.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555898/" },
    { "id": "mul-037", "trilhaId": "saude-mulher", "termo": "Incontinência urinária mista", "definicao": "Combinação de perda de urina por esforço e por urgência no mesmo paciente.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559095/" },
    { "id": "mul-038", "trilhaId": "saude-mulher", "termo": "Bexiga hiperativa", "definicao": "Urgência miccional com ou sem incontinência, frequência aumentada e noctúria, por hiperatividade do detrusor.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Illu_bladder.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Illu_bladder.jpg", "imagemCredito": "U.S. National Cancer Institute's Surveillance, Epidemiology and End Results (SEER) Program · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559095/" },
    { "id": "mul-039", "trilhaId": "saude-mulher", "termo": "Síndrome geniturinária da menopausa", "definicao": "Conjunto de sintomas vulvovaginais e urinários pela queda de estrogênio, como secura, ardência e urgência.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Vaginal_Mucosa_Normal_vs_Menopause.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Vaginal_Mucosa_Normal_vs_Menopause.png", "imagemCredito": "BruceBlaus · CC BY-SA 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559297/" },
