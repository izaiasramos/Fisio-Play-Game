    { "id": "mul-032", "trilhaId": "saude-mulher", "termo": "Esfíncter uretral", "definicao": "Musculatura que mantém a uretra fechada em repouso; sua fraqueza contribui para a incontinência urinária de esforço.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-033", "trilhaId": "saude-mulher", "termo": "Treinamento vesical", "definicao": "Programa de micções em horários progressivamente espaçados para reeducar a bexiga, útil na urgência miccional.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559095/" },
    { "id": "mul-034", "trilhaId": "saude-mulher", "termo": "Cones vaginais", "definicao": "Dispositivos com pesos progressivos usados para treinar a força do assoalho pélvico por resistência.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555898/" },
