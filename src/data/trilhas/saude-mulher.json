    { "id": "mul-030", "trilhaId": "saude-mulher", "termo": "Hipertonia do assoalho pélvico", "definicao": "Tônus excessivo e incapacidade de relaxar a musculatura pélvica, causando dor, dificuldade de evacuar e dispareunia.", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
