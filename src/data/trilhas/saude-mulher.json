    { "id": "mul-001", "trilhaId": "saude-mulher", "termo": "Assoalho pélvico", "definicao": "Conjunto de músculos e fáscias que fecham a pelve por baixo, sustentam os órgãos pélvicos e controlam a continência.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Pelvic_Muscles_%28Female_Side%29.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Pelvic_Muscles_(Female_Side).png", "imagemCredito": "BruceBlaus · CC BY-SA 4.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-002", "trilhaId": "saude-mulher", "termo": "Músculo levantador do ânus", "definicao": "Principal músculo do assoalho pélvico (pubococcígeo, puborretal e iliococcígeo) responsável pelo suporte dos órgãos pélvicos.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-003", "trilhaId": "saude-mulher", "termo": "Períneo", "definicao": "Região entre a vulva/ânus que contém a musculatura superficial do assoalho pélvico; pode ser lesada no parto.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/1116_Muscle_of_the_Perineum.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:1116_Muscle_of_the_Perineum.jpg", "imagemCredito": "OpenStax · CC BY 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-004", "trilhaId": "saude-mulher", "termo": "Disfunção do assoalho pélvico", "definicao": "Falha de suporte, coordenação ou controle da musculatura pélvica, causando incontinência, prolapso ou dor pélvica.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/1116_Muscle_of_the_Perineum.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:1116_Muscle_of_the_Perineum.jpg", "imagemCredito": "OpenStax · CC BY 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-005", "trilhaId": "saude-mulher", "termo": "Exercícios de Kegel", "definicao": "Contrações voluntárias repetidas do assoalho pélvico para fortalecer a musculatura e tratar incontinência e prolapso.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray405.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray405.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555898/" },
    { "id": "mul-006", "trilhaId": "saude-mulher", "termo": "Biofeedback perineal", "definicao": "Técnica que dá retorno visual ou sonoro da contração perineal, ajudando a paciente a ativar corretamente o assoalho pélvico.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Biofeedback_en.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Biofeedback_en.svg", "imagemCredito": "Biofeedback.png : Marek Jacenko derivative work: Morn · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555898/" },
    { "id": "mul-007", "trilhaId": "saude-mulher", "termo": "Incontinência urinária", "definicao": "Perda involuntária de urina; classificada em esforço, urgência, mista, funcional e por transbordamento.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Female_and_Male_Urethra.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Female_and_Male_Urethra.jpg", "imagemCredito": "OpenStax College · CC BY 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559095/" },
    { "id": "mul-008", "trilhaId": "saude-mulher", "termo": "Incontinência urinária de esforço", "definicao": "Perda de urina ao aumentar a pressão intra-abdominal (tossir, espirrar, rir, esforço), por fraqueza do esfíncter/assoalho pélvico.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray404.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray404.png", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK539769/" },
    { "id": "mul-009", "trilhaId": "saude-mulher", "termo": "Incontinência urinária de urgência", "definicao": "Perda de urina precedida de forte e súbita vontade de urinar, associada à hiperatividade do detrusor.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559095/" },
    { "id": "mul-010", "trilhaId": "saude-mulher", "termo": "Incontinência fecal", "definicao": "Perda involuntária de fezes ou gases por comprometimento da musculatura ou inervação do assoalho pélvico.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Anorectum-en.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Anorectum-en.svg", "imagemCredito": "Waterced · CC BY-SA 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-011", "trilhaId": "saude-mulher", "termo": "Prolapso de órgão pélvico", "definicao": "Descida de bexiga, útero ou reto pela vagina por falha de suporte do assoalho pélvico, comum após parto ou na menopausa.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Uterine_prolapse_-_standing.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Uterine_prolapse_-_standing.jpg", "imagemCredito": "Mikael Häggström · CC0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK563229/" },
    { "id": "mul-012", "trilhaId": "saude-mulher", "termo": "Cistocele", "definicao": "Prolapso da parede vaginal anterior com descida da bexiga; um tipo específico de prolapso de órgão pélvico.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Cysctocele_hariadhi.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Cysctocele_hariadhi.svg", "imagemCredito": "Hariadhi · CC BY-SA 4.0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK563229/" },
    { "id": "mul-013", "trilhaId": "saude-mulher", "termo": "Pessário", "definicao": "Dispositivo inserido na vagina que dá suporte mecânico aos órgãos pélvicos no tratamento conservador do prolapso.", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK563229/" },
    { "id": "mul-014", "trilhaId": "saude-mulher", "termo": "Diástase do reto abdominal", "definicao": "Afastamento dos ventres do reto abdominal na linha alba, comum no pós-parto; associada a lombalgia e incontinência.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Hernie_ligne_blanche.JPG?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Hernie_ligne_blanche.JPG", "imagemCredito": "Wikigil · CC BY-SA 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK573063/" },
    { "id": "mul-015", "trilhaId": "saude-mulher", "termo": "Fisiologia da gestação", "definicao": "Conjunto de adaptações cardiovasculares, respiratórias, musculoesqueléticas e hormonais do corpo durante a gravidez.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/PregnantWoman.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:PregnantWoman.jpg", "imagemCredito": "Ken Hammond (USDA) · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559304/" },
    { "id": "mul-016", "trilhaId": "saude-mulher", "termo": "Trimestres da gestação", "definicao": "A gravidez divide-se em três trimestres (~13 semanas cada), com demandas e cuidados fisioterapêuticos distintos.", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559304/" },
    { "id": "mul-017", "trilhaId": "saude-mulher", "termo": "Alterações posturais na gestação", "definicao": "Hiperlordose lombar e anteriorização do centro de gravidade pelo crescimento do útero, causando dor lombopélvica.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559304/" },
    { "id": "mul-018", "trilhaId": "saude-mulher", "termo": "Puerpério", "definicao": "Período pós-parto (até ~6 semanas) de retorno gradual das adaptações da gravidez; foco em recuperação do assoalho pélvico e postura.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Mother_and_newborn_child_in_Orissa.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Mother_and_newborn_child_in_Orissa.jpg", "imagemCredito": "Pippa Ranger/Department for International Development · CC BY-SA 2.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559304/" },
    { "id": "mul-019", "trilhaId": "saude-mulher", "termo": "Dor pélvica crônica", "definicao": "Dor na região pélvica por mais de 6 meses, muitas vezes ligada à disfunção (hipertonia) do assoalho pélvico.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482200/" },
    { "id": "mul-020", "trilhaId": "saude-mulher", "termo": "Endometriose", "definicao": "Presença de tecido endometrial fora do útero, causando dor pélvica, dismenorreia e, por vezes, infertilidade.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/202503_Endometriosis_with_annotation.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:202503_Endometriosis_with_annotation.svg", "imagemCredito": "Femke · CC BY 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK567777/" },
    { "id": "mul-021", "trilhaId": "saude-mulher", "termo": "Dismenorreia", "definicao": "Cólica menstrual dolorosa; pode ser primária (sem doença de base) ou secundária a condições como a endometriose.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/MenstrualCycle_gen.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:MenstrualCycle_gen.svg", "imagemCredito": "MenstrualCycle_en.svg : Speck-Made derivative work: A7N8X ( talk ) · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK567777/" },
    { "id": "mul-022", "trilhaId": "saude-mulher", "termo": "Dispareunia", "definicao": "Dor durante a relação sexual, frequentemente associada à hipertonia do assoalho pélvico ou à endometriose.", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK567777/" },
    { "id": "mul-023", "trilhaId": "saude-mulher", "termo": "Menopausa", "definicao": "Cessação permanente da menstruação (12 meses sem menstruar) pela queda dos estrogênios; marca o fim do período reprodutivo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Symptoms_of_menopause_%28vector%29.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Symptoms_of_menopause_(vector).svg", "imagemCredito": "Mikael Häggström · CC0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK507826/" },
    { "id": "mul-024", "trilhaId": "saude-mulher", "termo": "Climatério", "definicao": "Transição entre a fase reprodutiva e a não reprodutiva, ao redor da menopausa, com sintomas como fogachos e alterações do humor.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK507826/" },
    { "id": "mul-025", "trilhaId": "saude-mulher", "termo": "Osteoporose pós-menopausa", "definicao": "Perda de massa óssea acelerada pela queda de estrogênio, aumentando o risco de fraturas; o exercício resistido ajuda a preveni-la.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/OsteoCutout.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:OsteoCutout.png", "imagemCredito": "James Heilman, MD · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK507826/" },
    { "id": "mul-026", "trilhaId": "saude-mulher", "termo": "Linfedema", "definicao": "Acúmulo de linfa nos tecidos por comprometimento do sistema linfático, causando edema crônico de um membro.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Lymph%C3%B6dem.JPG?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Lymphödem.JPG", "imagemCredito": "Abdullah Sarhan · CC BY-SA 4.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537239/" },
