    { "id": "mul-028", "trilhaId": "saude-mulher", "termo": "Drenagem linfática manual", "definicao": "Técnica de massagem suave que estimula o fluxo da linfa para reduzir o edema no tratamento do linfedema.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537239/" },
