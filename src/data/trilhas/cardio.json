  "itens": [
    { "id": "car-001", "trilhaId": "cardio", "termo": "Insuficiência cardíaca", "definicao": "Síndrome clínica em que o coração não supre as demandas metabólicas do corpo (por falha de contração e/ou de enchimento), com dispneia, fadiga e congestão/edema; classifica-se pela fração de ejeção (reduzida, levemente reduzida ou preservada).", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Elevated_JVP.JPG?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Elevated_JVP.JPG", "imagemCredito": "James Heilman, MD · CC BY-SA 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430873/" },
    { "id": "car-002", "trilhaId": "cardio", "termo": "Classificação NYHA", "definicao": "Estratifica a insuficiência cardíaca em classes I a IV conforme a limitação funcional causada pelos sintomas aos esforços.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430873/" },
    { "id": "car-003", "trilhaId": "cardio", "termo": "Fração de ejeção", "definicao": "Percentual do volume de sangue ejetado pelo ventrículo esquerdo a cada sístole; usada para classificar a insuficiência cardíaca.", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430873/" },
    { "id": "car-004", "trilhaId": "cardio", "termo": "Doença arterial coronariana", "definicao": "Redução do fluxo coronariano por aterosclerose, que causa isquemia miocárdica e pode levar a angina e infarto.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Blausen_0259_CoronaryArteryDisease_02.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Blausen_0259_CoronaryArteryDisease_02.png", "imagemCredito": "BruceBlaus . When using this image in external sources it can be cited as: Blausen.com staff (2014). ' Medical · CC BY 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK535419/" },
    { "id": "car-005", "trilhaId": "cardio", "termo": "Angina de peito", "definicao": "Dor ou desconforto torácico por isquemia miocárdica, tipicamente desencadeada por esforço e aliviada pelo repouso.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/A_man_having_a_Heart_Attack.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:A_man_having_a_Heart_Attack.png", "imagemCredito": "https://www.myupchar.com/en · CC BY-SA 4.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK557672/" },
    { "id": "car-006", "trilhaId": "cardio", "termo": "Infarto agudo do miocárdio", "definicao": "Necrose do músculo cardíaco por obstrução do fluxo coronariano; cursa com dor torácica, alterações no ECG e elevação de troponina.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Blausen_0463_HeartAttack.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Blausen_0463_HeartAttack.png", "imagemCredito": "Blausen Medical Communications, Inc. · CC BY 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK459269/" },
    { "id": "car-007", "trilhaId": "cardio", "termo": "IAM com supra de ST (STEMI)", "definicao": "Infarto com elevação do segmento ST no ECG, indicando oclusão coronariana total e necessidade de reperfusão urgente.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Blausen_0463_HeartAttack.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Blausen_0463_HeartAttack.png", "imagemCredito": "Blausen Medical Communications, Inc. · CC BY 3.0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK532281/" },
    { "id": "car-008", "trilhaId": "cardio", "termo": "Troponina", "definicao": "Biomarcador liberado na lesão do miócito cardíaco; sua elevação confirma injúria miocárdica, como no infarto.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Troponin_Ribbon_Diagram.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Troponin_Ribbon_Diagram.png", "imagemCredito": "MetskasLA · CC0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537076/" },
    { "id": "car-009", "trilhaId": "cardio", "termo": "Fibrilação atrial", "definicao": "Arritmia supraventricular mais comum, com atividade elétrica atrial desorganizada, ritmo irregular e risco aumentado de AVC.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Afib_ecg.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Afib_ecg.svg", "imagemCredito": "J. Heuser ; vectorised and touched up by Marnanel · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK526072/" },
    { "id": "car-010", "trilhaId": "cardio", "termo": "Eletrocardiograma (ECG)", "definicao": "Registro da atividade elétrica do coração ao longo do tempo, usado para avaliar ritmo, frequência e isquemia.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/SinusRhythmLabels.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:SinusRhythmLabels.svg", "imagemCredito": "Created by Agateller (Anthony Atkielski) , converted to svg by atom . · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555952/" },
    { "id": "car-011", "trilhaId": "cardio", "termo": "Ritmo sinusal", "definicao": "Ritmo cardíaco normal, comandado pelo nó sinoatrial, com onda P precedendo cada complexo QRS.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/SinusRhythmLabels.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:SinusRhythmLabels.svg", "imagemCredito": "Created by Agateller (Anthony Atkielski) , converted to svg by atom . · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555952/" },
    { "id": "car-012", "trilhaId": "cardio", "termo": "Complexo QRS", "definicao": "Deflexão do ECG que representa a despolarização dos ventrículos; seu alargamento sugere condução anormal.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/SinusRhythmLabels.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:SinusRhythmLabels.svg", "imagemCredito": "Created by Agateller (Anthony Atkielski) , converted to svg by atom . · Public domain", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK555952/" },
    { "id": "car-013", "trilhaId": "cardio", "termo": "Pressão arterial", "definicao": "A sistólica corresponde ao pico de pressão durante a ejeção ventricular e a diastólica à pressão que resta no leito arterial entre os batimentos; a diferença entre as duas é a pressão de pulso.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Blood_pressure_monitoring.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Blood_pressure_monitoring.jpg", "imagemCredito": "rawpixel.com · CC0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482189/" },
    { "id": "car-014", "trilhaId": "cardio", "termo": "Hipertensão arterial", "definicao": "Elevação crônica da pressão arterial que sobrecarrega o coração e os vasos, aumentando o risco cardiovascular.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Grade_1_hypertension.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Grade_1_hypertension.jpg", "imagemCredito": "Steven Fruitsmaak · CC BY 3.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK539800/" },
    { "id": "car-015", "trilhaId": "cardio", "termo": "Frequência cardíaca", "definicao": "Ritmo imposto pelo nó sinoatrial e modulado pelo sistema autônomo: o simpático o acelera e o parassimpático, pelo nervo vago, o desacelera.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Normal_electrocardiogram.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Normal_electrocardiogram.jpg", "imagemCredito": "medipics1066 · CC BY 2.0", "dificuldade": 1, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-4-cardiac-physiology" },
    { "id": "car-016", "trilhaId": "cardio", "termo": "Ciclo cardíaco", "definicao": "Sequência de sístole (contração) e diástole (relaxamento) que enche e ejeta o sangue das câmaras cardíacas.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/2027_Phases_of_the_Cardiac_Cycle.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:2027_Phases_of_the_Cardiac_Cycle.jpg", "imagemCredito": "OpenStax College · CC BY 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK459327/" },
    { "id": "car-017", "trilhaId": "cardio", "termo": "Bulhas cardíacas B1 e B2", "definicao": "B1 marca o fechamento das valvas atrioventriculares (mitral/tricúspide) e B2 o das valvas semilunares (aórtica/pulmonar).", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Gray1216_modern_locations.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Gray1216_modern_locations.svg", "imagemCredito": "Henry Vandyke Carter · Public domain", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-4-cardiac-physiology" },
    { "id": "car-018", "trilhaId": "cardio", "termo": "Sopro cardíaco", "definicao": "Som anormal na ausculta gerado por fluxo sanguíneo turbulento, frequentemente associado a valvopatias.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Phonocardiograms_from_normal_and_abnormal_heart_sounds.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Phonocardiograms_from_normal_and_abnormal_heart_sounds.svg", "imagemCredito": "Madhero88 · CC BY-SA 3.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-4-cardiac-physiology" },
    { "id": "car-019", "trilhaId": "cardio", "termo": "Débito cardíaco", "definicao": "Volume de sangue ejetado pelo coração por minuto; é o produto da frequência cardíaca pelo volume sistólico.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/2031_Factors_in_Cardiac_Output.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:2031_Factors_in_Cardiac_Output.jpg", "imagemCredito": "OpenStax College · CC BY 3.0", "dificuldade": 3, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-4-cardiac-physiology" },
    { "id": "car-020", "trilhaId": "cardio", "termo": "Oximetria de pulso (SpO2)", "definicao": "Método não invasivo que estima a saturação pela absorção de luz em dois comprimentos de onda no leito capilar pulsátil; má perfusão, movimento, esmalte escuro e intoxicação por monóxido de carbono falseiam a leitura.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Wrist-oximeter.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Wrist-oximeter.jpg", "imagemCredito": "UusiAjaja · CC0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK470348/" },
    { "id": "car-021", "trilhaId": "cardio", "termo": "Dispneia", "definicao": "Sensação subjetiva de falta de ar ou esforço respiratório aumentado, comum em doenças cardíacas e pulmonares.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/SymptomsFeverCoughSOB_%28cropped%29.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:SymptomsFeverCoughSOB_(cropped).jpg", "imagemCredito": "CDC · Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK499965/" },
    { "id": "car-022", "trilhaId": "cardio", "termo": "Cianose", "definicao": "Coloração azulada da pele e mucosas por baixa saturação de oxigênio no sangue.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Cynosis.JPG?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Cynosis.JPG", "imagemCredito": "James Heilman, MD · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559167/" },
    { "id": "car-023", "trilhaId": "cardio", "termo": "DPOC", "definicao": "Doença pulmonar obstrutiva crônica: limitação persistente e progressiva do fluxo aéreo, geralmente ligada ao tabagismo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Copd_versus_healthy_lung.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Copd_versus_healthy_lung.jpg", "imagemCredito": "Public domain", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK559281/" },
    { "id": "car-024", "trilhaId": "cardio", "termo": "Asma", "definicao": "Doença inflamatória crônica das vias aéreas com broncoconstrição reversível, causando sibilos, tosse e dispneia.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Asthma_%28Lungs%29.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Asthma_(Lungs).png", "imagemCredito": "BruceBlaus · CC BY-SA 4.0", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK430901/" },
    { "id": "car-025", "trilhaId": "cardio", "termo": "Espirometria", "definicao": "Teste de função pulmonar que mede volumes e fluxos de ar; distingue padrões obstrutivos de restritivos.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Flow-volume-loop.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Flow-volume-loop.svg", "imagemCredito": "SPhotographer , Jmarchn · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK482339/" },
    { "id": "car-026", "trilhaId": "cardio", "termo": "Gasometria arterial", "definicao": "Análise do sangue arterial que mede PaO2, PaCO2 e pH; padrão-ouro para avaliar oxigenação e ventilação.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Davenport_fig_10.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Davenport_fig_10.jpg", "imagemCredito": "User:Thewookie55 · Public domain", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK536919/" },
    { "id": "car-027", "trilhaId": "cardio", "termo": "Teste de caminhada de 6 minutos", "definicao": "Mede a distância percorrida em 6 min para avaliar a capacidade funcional em doenças cardíacas e respiratórias crônicas.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK576420/" },
    { "id": "car-028", "trilhaId": "cardio", "termo": "Escala de Borg", "definicao": "Escala de percepção subjetiva do esforço/dispneia, usada para dosar e monitorar o exercício na reabilitação.", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537196/" },
    { "id": "car-029", "trilhaId": "cardio", "termo": "Reabilitação cardíaca", "definicao": "Programa supervisionado de exercícios, educação e mudança de hábitos que melhora a capacidade funcional após eventos cardíacos.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Stress_test.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Stress_test.jpg", "imagemCredito": "Blue0ctane (English Wikipedia) · Domínio público", "dificuldade": 1, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK537196/" },
    { "id": "car-030", "trilhaId": "cardio", "termo": "Trocas gasosas", "definicao": "Difusão de oxigênio e gás carbônico entre alvéolos e capilares pulmonares, essencial para a oxigenação do sangue.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Alveolus_diagram.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Alveolus_diagram.svg", "imagemCredito": "LadyofHats · Public domain", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/22-4-gas-exchange" },
    { "id": "car-031", "trilhaId": "cardio", "termo": "Valva mitral", "definicao": "Valva atrioventricular esquerda (bicúspide) que impede o refluxo do ventrículo esquerdo para o átrio esquerdo.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Diagram_of_the_human_heart_%28cropped%29.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Diagram_of_the_human_heart_(cropped).svg", "imagemCredito": "Wapcaplet · CC BY-SA 3.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-1-heart-anatomy" },
    { "id": "car-032", "trilhaId": "cardio", "termo": "Valva aórtica", "definicao": "Valva semilunar entre o ventrículo esquerdo e a aorta; impede o refluxo de sangue de volta ao coração na diástole.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Diagram_of_the_human_heart_%28cropped%29.svg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Diagram_of_the_human_heart_(cropped).svg", "imagemCredito": "Wapcaplet · CC BY-SA 3.0", "dificuldade": 2, "fonte": "OpenStax — Anatomy & Physiology 2e (CC BY 4.0)", "urlFonte": "https://openstax.org/books/anatomy-and-physiology-2e/pages/19-1-heart-anatomy" },
    { "id": "car-033", "trilhaId": "cardio", "termo": "Estenose aórtica", "definicao": "Estreitamento da valva aórtica que obstrui a saída do ventrículo esquerdo, causando dispneia, angina e síncope aos esforços.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Aortic_stenosis_rheumatic%2C_gross_pathology_20G0014_lores.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Aortic_stenosis_rheumatic,_gross_pathology_20G0014_lores.jpg", "imagemCredito": "CDC/Dr. Edwin P. Ewing, Jr. · Public domain", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK557628/" },
    { "id": "car-034", "trilhaId": "cardio", "termo": "Insuficiência mitral", "definicao": "Fechamento incompleto da valva mitral que permite refluxo para o átrio esquerdo, sobrecarregando o coração.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Mitral_Regurgitation_scheme1.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Mitral_Regurgitation_scheme1.png", "imagemCredito": "CC BY-SA 2.5", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK553135/" },
    { "id": "car-035", "trilhaId": "cardio", "termo": "Edema agudo de pulmão", "definicao": "Acúmulo súbito de líquido nos alvéolos, geralmente por falência cardíaca esquerda, causando dispneia intensa.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/PulmEdema.PNG?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:PulmEdema.PNG", "imagemCredito": "James Heilman, MD · CC BY-SA 3.0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK557611/" },
    { "id": "car-036", "trilhaId": "cardio", "termo": "Trombose venosa profunda", "definicao": "Formação de trombo em veia profunda (comum na perna), com risco de embolia pulmonar; cursa com dor e edema.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Deep_vein_thrombosis_of_the_right_leg.jpg?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Deep_vein_thrombosis_of_the_right_leg.jpg", "imagemCredito": "James Heilman, MD · CC BY-SA 3.0", "dificuldade": 2, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK507708/" },
    { "id": "car-037", "trilhaId": "cardio", "termo": "Embolia pulmonar", "definicao": "Obstrução de artéria pulmonar por trombo (em geral de TVP), causando dispneia súbita, dor torácica e hipoxemia.", "imagem": "https://commons.wikimedia.org/wiki/Special:FilePath/Pulmonary-embolism.png?width=800", "imagemFonte": "https://commons.wikimedia.org/wiki/File:Pulmonary-embolism.png", "imagemCredito": "Baedr-9439 · CC0", "dificuldade": 3, "fonte": "StatPearls — NCBI Bookshelf (CC BY-NC-ND 4.0)", "urlFonte": "https://www.ncbi.nlm.nih.gov/books/NBK560551/" },
